#!/usr/bin/env bash
# Builds rubyscope and installs it for this user on macOS:
#   ~/Applications/rubyscope.app (open it from Spotlight, Launchpad or the Dock)
#   ~/.local/bin/rubyscope and ~/.local/bin/rubyscope-cli
set -euo pipefail
cd "$(dirname "$0")/.."
cargo build --release -p rubyscope -p rubyscope-cli

app="$HOME/Applications/rubyscope.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp packaging/macos/Info.plist "$app/Contents/Info.plist"
cp target/release/rubyscope "$app/Contents/MacOS/rubyscope"

# The icon: an .icns made from the PNG sizes in packaging/icon.
iconset="$(mktemp -d)/rubyscope.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
  cp "packaging/icon/rubyscope-$size.png" "$iconset/icon_${size}x${size}.png"
done
cp packaging/icon/rubyscope-32.png "$iconset/icon_16x16@2x.png"
cp packaging/icon/rubyscope-64.png "$iconset/icon_32x32@2x.png"
cp packaging/icon/rubyscope-256.png "$iconset/icon_128x128@2x.png"
cp packaging/icon/rubyscope-512.png "$iconset/icon_256x256@2x.png"
iconutil -c icns "$iconset" -o "$app/Contents/Resources/rubyscope.icns"
rm -rf "$(dirname "$iconset")"

# The terminal command starts the same binary as the app.
mkdir -p "$HOME/.local/bin"
ln -sf "$app/Contents/MacOS/rubyscope" "$HOME/.local/bin/rubyscope"
install -m755 target/release/rubyscope-cli "$HOME/.local/bin/rubyscope-cli"
touch "$app"
echo "Installed rubyscope.app in ~/Applications. Run: rubyscope <project folder>"
